# Copy this file to `.env.local` for machine-specific overrides.
# Keep public/default hostnames in git; keep personal or temporary hosts local-only.
HOST_NAME=dev.impro.social
ENVIRONMENT=development

# Optional: force OAuth to use a separate public origin.
# Example: OAUTH_ORIGIN=https://dev.example.com
# OAUTH_ORIGIN=

# Optional when using Capacitor live reload on a local network device.
# LOCAL_IP=192.168.1.10
