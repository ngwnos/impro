{
  "name": "archery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --outfile=main.js",
    "watch": "esbuild src/main.js --bundle --format=esm --outfile=main.js --watch",
    "start": "npm run watch",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
